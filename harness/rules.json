{
  "version": 1,
  "description": "요금제 추천·구독 하네스 규칙. 서비스가 바뀌면 critical·excluded·sample만 교체한다. 값의 SSOT는 docs/tokens.json이다.",

  "sourcePriority": {
    "function": ["docs/PRD.md", "docs/screens.md"],
    "visual": ["docs/Design.md"],
    "values": ["docs/tokens.json", "harness/rules.json#layout"]
  },

  "critical": [
    {
      "id": "A",
      "name": "⛔(A) 금액 규칙",
      "text": "카드·상세 한 곳에 서로 다른 금액 값은 최대 2개(매달 내는 금액 1개 + 할인 종료 후 금액 1개)이고, 그 외 금액은 없다. '25개월째부터'는 할인 종료 후 금액이 있는 요금제에만 있다.",
      "maxDistinctAmounts": 2,
      "afterDiscountMarker": "25개월째부터",
      "moneyPattern": "(\\d{1,3}(?:,\\d{3})+|\\d+)\\s*원",
      "ox": [3, 4]
    },
    {
      "id": "B",
      "name": "⛔(B) 무제한 속도 규칙",
      "text": "이름에 '무제한'이 들어간 요금제의 카드·상세에는 '소진 후 ○Mbps로 제한' 또는 '속도 제한 없음'이 정확히 1개 있다.",
      "planNameIncludes": "무제한",
      "throttlePattern": "소진 후 \\d+(?:\\.\\d+)?Mbps로 제한|속도 제한 없음",
      "exactCount": 1,
      "ox": [5]
    }
  ],

  "ox": [
    { "id": 1, "name": "O/X #1 카드 4개", "check": "plans.cardCount" },
    { "id": 2, "name": "O/X #2 추천 Tag 1개", "check": "plans.tagCount" },
    { "id": 3, "name": "O/X #3 금액 2종 이하", "check": "critical.A" },
    {
      "id": 4,
      "name": "O/X #4 할인 종료 후 금액은 할인 요금제만",
      "check": "critical.A"
    },
    {
      "id": 5,
      "name": "O/X #5 무제한 요금제 속도 문구",
      "check": "critical.B"
    },
    {
      "id": 6,
      "name": "O/X #6 신청하기 비활성 조건",
      "check": "apply.disabled"
    },
    { "id": 7, "name": "O/X #7 완료 화면 값 일치", "check": "flow.complete" }
  ],

  "layout": {
    "source": "docs/Design.md §3 '390 × 844 모바일 기준', §4 Button 높이. border-w는 문서에 없어 R5에서 승인한 예외.",
    "values": {
      "header-h": 56,
      "cta-h": 97,
      "cta-price-h": 139,
      "control-min-h": 40,
      "button-lg-h": 48,
      "button-xl-h": 52,
      "content-w": 358,
      "viewport-h": 844,
      "border-w": 1
    }
  },

  "viewport": { "width": 390, "height": 844 },

  "excluded": {
    "reason": "PRD '확인 필요' 항목. 확정 전까지 구현하지 않는다.",
    "components": ["OptionItem"],
    "selectors": ["[data-component=\"OptionItem\"]", "[data-slot=\"sale\"]"],
    "textByRoute": { "/plans/:id": ["통화", "문자"] }
  },

  "dom": {
    "componentAttr": "data-component",
    "rules": [
      "모든 UI 컴포넌트 루트 요소에 data-component=\"<Design.md 이름>\" (예: \"Card/Plan\", \"icon/arrowLeft\")",
      "Card/Plan 루트에 data-plan-id=\"<요금제 id>\"",
      "Input 루트에 data-field=\"name\" | \"phone\", 내부에 실제 <input>",
      "Checkbox는 실제 <input type=\"checkbox\">를 포함",
      "Button은 실제 <button>. 비활성은 disabled 속성",
      "FilterChip은 <button aria-pressed>",
      "뒤로 아이콘은 <button aria-label=\"뒤로\"> 안에 icon/arrowLeft",
      "Card/Plan의 Sale 요소는 만들지 않는다 (만들면 data-slot=\"sale\"로 걸린다)"
    ]
  },

  "sample": {
    "detailPlanId": "p03",
    "flowPlanId": "p03",
    "applicant": { "name": "홍길동", "phone": "01012345678" }
  },

  "agents": {
    "spec-reader": { "stage": 1, "edit": ["harness/out/01-spec.json"] },
    "layout-planner": { "stage": 2, "edit": ["harness/out/02-layout.json"] },
    "ui-builder": { "stage": 3, "edit": ["src/components/ui/"] },
    "screen-builder": { "stage": 4, "edit": ["src/pages/"] },
    "gate-judge": { "stage": 5, "edit": [] }
  },

  "protected": ["docs/", "reference/"],

  "generated": [
    "src/styles/tokens.css",
    "src/router.tsx",
    "src/main.tsx",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "eslint.config.js",
    "package.json",
    "package-lock.json"
  ],

  "maxAttempts": 3,
  "branchPrefix": "harness/run-"
}
